# Required
DATABASE_URL=postgres://user:password@host:5432/sfsi   # Neon/Supabase pooled URL in production
AUTH_SECRET=                                           # random string, 32+ chars: openssl rand -base64 48
SITE_URL=https://floridasimchah.org                     # used in email links and Stripe redirects

# First admin (used by `npm run db:seed`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Email notifications (optional — logged to console when unset)
RESEND_API_KEY=
EMAIL_FROM="SFSI <no-reply@floridasimchah.org>"
OPERATOR_EMAILS=ops@floridasimchah.org                  # comma-separated; gets new submissions, acceptances, payments

# Online payments (optional — without these, families pay offline and operators record payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                                  # endpoint: /api/stripe/webhook, event checkout.session.completed
PAYMENT_INSTRUCTIONS="Checks payable to “South Florida Simchah Initiative.” Zelle details are available from your coordinator."

# Defaults
DEFAULT_DEPOSIT_PERCENT=25
DEFAULT_INSTALLMENTS=3
DEFAULT_FINAL_DUE_DAYS=14
DEFAULT_TAX_BPS=700                                     # 7.00% (basis points)
NEXT_PUBLIC_DONATE_URL=                                 # optional external donation page
